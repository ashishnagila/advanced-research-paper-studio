# Required: create an API key in your OpenAI Platform account.
OPENAI_API_KEY=replace_me
# Use a model available to your API project. Change if needed.
OPENAI_MODEL=gpt-5.5
# Required for a public deployment: choose a long random password.
APP_PASSWORD=replace_with_a_long_random_password
# Optional: set to your public frontend origin if frontend and backend are hosted separately.
ALLOWED_ORIGIN=
PORT=3000
MAX_UPLOAD_MB=15
